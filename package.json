{
  "name": "stupdt-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "backend": "cd ../STUPDT_BACKEND && .venv/bin/uvicorn app.main:app --reload --port 8000",
    "dev:backend": "cd ../STUPDT_BACKEND && .venv/bin/uvicorn app.main:app --reload --port 8000",
    "build": "tsc -b && vp build",
    "lint": "vp lint",
    "preview": "vp preview",
    "sprites": "node scripts/build-sprites.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
