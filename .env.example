# StuPDT Frontend Environment Variables

# Vite dev proxy target for /api (defaults to http://127.0.0.1:8000)
VITE_BACKEND_URL=http://127.0.0.1:8000

# Optional backend base URL override (leave blank to use relative /api proxy)
# VITE_API_BASE_URL=http://localhost:8000

# Optional: Add your Gemini API key for local client-side dev testing
# VITE_GEMINI_API_KEY=
